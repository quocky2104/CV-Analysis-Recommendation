# ============================================
# CVision AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit your .env file with real secrets.

# --- AI Provider ---
# Options: "openai" or "mock"
# In mock mode, analysis results are rule-based demonstrations, clearly labeled.
AI_PROVIDER=mock

# --- OpenAI Configuration ---
# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=
# Model to use. Examples: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Must support Structured Outputs (JSON mode / response_format)
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# SQLite (default) or PostgreSQL
# SQLite: sqlite:///./cvision.db
# PostgreSQL: postgresql://user:password@localhost:5432/cvision
DATABASE_URL=sqlite:///./cvision.db

# --- File Upload Limits ---
MAX_FILE_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=60000

# --- CORS ---
# Comma-separated list of allowed origins
FRONTEND_ORIGINS=http://localhost:3000

# --- Application ---
APP_ENV=development
# Secret key for session management (generate a random string)
SECRET_KEY=change-me-to-a-random-secret

# --- Frontend (public, prefixed with NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
